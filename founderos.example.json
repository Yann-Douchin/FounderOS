{
  "display": {
    "host": "127.0.0.1:8080",
    "application_name": "founderos",
    "device_priority": 90,
    "min_hold_seconds": 6,
    "lease_seconds": 300,
    "lease_refresh_ratio": 0.8,
    "conflict_retry_seconds": 2,
    "conflict_retry_max_seconds": 30,
    "clear_on_shutdown": true,
    "text_rendering": "auto",
    "content_icon": {
      "enabled": true,
      "frame_seconds": 1.0
    }
  },
  "automations": {
    "calendar_busy_indicator": {
      "enabled": false,
      "mode": "busybar_matter",
      "host": "",
      "require_pairing": true,
      "include_all_day": false,
      "include_tentative": true,
      "off_delay_seconds": 15,
      "lease_min_ttl_seconds": 5,
      "lease_max_ttl_seconds": 28800
    }
  },
  "interaction": {
    "enabled": false,
    "mode": "signed_http",
    "allow_key": "ok",
    "deny_key": "back",
    "action_consumer_enabled": true
  },
  "llm": {
    "enabled": false,
    "provider": "openai",
    "model": "gpt-5.6-sol",
    "api_key_env": "OPENAI_API_KEY",
    "max_calls_per_hour": 6
  },
  "connectors": {
    "demo": {
      "enabled": true,
      "scenario": "mixed",
      "poll_interval_seconds": 2
    },
    "linear": {
      "enabled": false,
      "mode": "api",
      "token_env": "LINEAR_API_KEY",
      "auth_scheme": "api_key",
      "scope": "assigned",
      "team_keys": [],
      "poll_interval_seconds": 30
    },
    "slack": {
      "enabled": false,
      "mode": "api",
      "token_env": "SLACK_BOT_TOKEN",
      "channel_ids": [],
      "channel_names": {},
      "mention_markers": [],
      "poll_interval_seconds": 60
    },
    "gmail": {
      "enabled": false,
      "mode": "api",
      "access_token_env": "GOOGLE_ACCESS_TOKEN",
      "query": "is:unread newer_than:2d",
      "vip_senders": [],
      "poll_interval_seconds": 60
    },
    "calendar": {
      "enabled": false,
      "mode": "api",
      "access_token_env": "GOOGLE_ACCESS_TOKEN",
      "calendar_id": "primary",
      "horizon_hours": 8,
      "poll_interval_seconds": 60
    },
    "linkedin": {
      "enabled": false,
      "feed_url": "",
      "token_env": "LINKEDIN_FEED_TOKEN",
      "poll_interval_seconds": 120
    },
    "claude": {
      "enabled": false,
      "mode": "agent_bridge",
      "usage": {
        "mode": "snapshot",
        "ttl_seconds": 900
      },
      "poll_interval_seconds": 2
    },
    "chatgpt_codex": {
      "enabled": false,
      "mode": "agent_bridge",
      "usage": {
        "mode": "codex_app_server",
        "codex_binary": "",
        "timeout_seconds": 5,
        "ttl_seconds": 120,
        "refresh_seconds": 60
      },
      "poll_interval_seconds": 2
    },
    "github": {
      "enabled": false
    },
    "stripe": {
      "enabled": false
    },
    "shopify": {
      "enabled": false
    },
    "home_assistant": {
      "enabled": false
    }
  }
}
