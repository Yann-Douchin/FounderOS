{
  "runtime": {
    "environment": "production",
    "timezone": "Europe/Madrid",
    "connector_workers": 6
  },
  "display": {
    "host": "127.0.0.1:8080",
    "application_name": "founderos",
    "device_priority": 90,
    "api_token_env": "BUSY_API_TOKEN",
    "api_semver": "25.0.0",
    "validate_on_start": true
  },
  "interaction": {
    "enabled": true,
    "mode": "signed_http",
    "listen_host": "127.0.0.1",
    "listen_port": 8765,
    "secret_env": "FOUNDEROS_INPUT_SECRET",
    "allow_key": "ok",
    "deny_key": "back",
    "acknowledge_key": "ok",
    "snooze_key": "back",
    "open_key": "custom",
    "snooze_minutes": 15
  },
  "llm": {
    "enabled": false
  },
  "connectors": {
    "demo": {
      "enabled": false
    },
    "linear": {
      "enabled": true,
      "mode": "api",
      "token_env": "LINEAR_API_KEY",
      "auth_scheme": "api_key",
      "scope": "portfolio",
      "team_keys": ["${LINEAR_TEAM_KEY}"],
      "max_pages": 20,
      "portfolio_priority_ceiling": 2,
      "portfolio_due_horizon_days": 14,
      "rollup_projects": true,
      "critical": true,
      "poll_interval_seconds": 30
    },
    "calendar": {
      "enabled": true,
      "mode": "api",
      "access_token_env": "GOOGLE_ACCESS_TOKEN",
      "refresh_token_env": "GOOGLE_REFRESH_TOKEN",
      "client_id_env": "GOOGLE_CLIENT_ID",
      "client_secret_env": "GOOGLE_CLIENT_SECRET",
      "calendar_id": "primary",
      "timezone": "Europe/Madrid",
      "page_size": 20,
      "max_events": 100,
      "max_pages": 20,
      "critical": true,
      "poll_interval_seconds": 60
    },
    "slack": {
      "enabled": true,
      "mode": "api",
      "token_env": "SLACK_BOT_TOKEN",
      "channel_ids": ["${SLACK_CHANNEL_ID}"],
      "mention_markers": ["${SLACK_MENTION_MARKER}"],
      "critical": true,
      "poll_interval_seconds": 60
    },
    "gmail": {
      "enabled": true,
      "mode": "api",
      "access_token_env": "GOOGLE_ACCESS_TOKEN",
      "refresh_token_env": "GOOGLE_REFRESH_TOKEN",
      "client_id_env": "GOOGLE_CLIENT_ID",
      "client_secret_env": "GOOGLE_CLIENT_SECRET",
      "query": "is:unread newer_than:2d",
      "critical": true,
      "poll_interval_seconds": 60
    },
    "claude": {
      "enabled": true,
      "mode": "agent_bridge",
      "usage": {
        "mode": "snapshot",
        "ttl_seconds": 900
      },
      "poll_interval_seconds": 2
    },
    "chatgpt_codex": {
      "enabled": true,
      "mode": "agent_bridge",
      "usage": {
        "mode": "codex_app_server",
        "timeout_seconds": 5,
        "ttl_seconds": 120,
        "refresh_seconds": 60
      },
      "poll_interval_seconds": 2
    },
    "github": {"enabled": false, "status": "planned"},
    "stripe": {"enabled": false, "status": "planned"},
    "shopify": {"enabled": false, "status": "planned"},
    "home_assistant": {"enabled": false, "status": "planned"}
  }
}
