{
  "runtime": {
    "environment": "production",
    "timezone": "Europe/Madrid",
    "connector_workers": 6
  },
  "closure": {
    "enabled": true,
    "default_owner": "self",
    "proof_profiles": {
      "release": {
        "required_categories": ["deployment", "analytics", "market", "language", "pricing", "device"],
        "minimum_categories": 6,
        "required_scopes": {}
      }
    }
  },
  "display": {
    "host": "127.0.0.1:8080",
    "application_name": "founderos",
    "device_priority": 90,
    "api_token_env": "BUSY_API_TOKEN",
    "api_semver": "25.0.0",
    "validate_on_start": true,
    "lease_seconds": 300,
    "text_rendering": "auto"
  },
  "automations": {
    "calendar_busy_indicator": {
      "enabled": false,
      "mode": "busybar_matter",
      "host": "",
      "api_token_env": "BUSY_API_TOKEN",
      "allow_insecure_http": false,
      "require_pairing": true,
      "include_all_day": false,
      "include_tentative": true,
      "off_delay_seconds": 15
    }
  },
  "interaction": {
    "enabled": true,
    "mode": "signed_http",
    "listen_host": "127.0.0.1",
    "listen_port": 8765,
    "secret_env": "FOUNDEROS_INPUT_SECRET",
    "allow_key": "ok",
    "deny_key": "back",
    "acknowledge_key": "ok",
    "snooze_key": "back",
    "open_key": "custom",
    "snooze_minutes": 15
  },
  "llm": {
    "enabled": false
  },
  "connectors": {
    "demo": {
      "enabled": false
    },
    "linear": {
      "enabled": true,
      "mode": "api",
      "token_env": "LINEAR_API_KEY",
      "auth_scheme": "api_key",
      "scope": "portfolio",
      "team_keys": ["${LINEAR_TEAM_KEY}"],
      "max_pages": 20,
      "portfolio_priority_ceiling": 2,
      "portfolio_due_horizon_days": 14,
      "rollup_projects": true,
      "critical": true,
      "poll_interval_seconds": 30
    },
    "calendar": {
      "enabled": true,
      "mode": "api",
      "access_token_env": "GOOGLE_ACCESS_TOKEN",
      "refresh_token_env": "GOOGLE_REFRESH_TOKEN",
      "client_id_env": "GOOGLE_CLIENT_ID",
      "client_secret_env": "GOOGLE_CLIENT_SECRET",
      "calendar_id": "primary",
      "timezone": "Europe/Madrid",
      "page_size": 20,
      "max_events": 100,
      "max_pages": 20,
      "critical": true,
      "poll_interval_seconds": 60
    },
    "slack": {
      "enabled": true,
      "mode": "api",
      "token_env": "SLACK_BOT_TOKEN",
      "channel_ids": ["${SLACK_CHANNEL_ID}"],
      "mention_markers": ["${SLACK_MENTION_MARKER}"],
      "self_user_ids": ["${SLACK_SELF_USER_ID}"],
      "max_threads_per_poll": 10,
      "critical": true,
      "poll_interval_seconds": 60
    },
    "gmail": {
      "enabled": true,
      "mode": "api",
      "access_token_env": "GOOGLE_ACCESS_TOKEN",
      "refresh_token_env": "GOOGLE_REFRESH_TOKEN",
      "client_id_env": "GOOGLE_CLIENT_ID",
      "client_secret_env": "GOOGLE_CLIENT_SECRET",
      "queries": [
        {"query": "is:unread newer_than:2d", "direction": "incoming"},
        {"query": "in:sent newer_than:30d {\"I will\" \"I'll\" \"I’ll\" \"we will\" \"je vais\" \"je vous envoie\" \"nous allons\" \"je reviens vers\"}", "direction": "outgoing"}
      ],
      "critical": true,
      "poll_interval_seconds": 60
    },
    "claude": {
      "enabled": true,
      "mode": "agent_bridge",
      "usage": {
        "mode": "snapshot",
        "ttl_seconds": 900
      },
      "poll_interval_seconds": 2
    },
    "chatgpt_codex": {
      "enabled": true,
      "mode": "agent_bridge",
      "usage": {
        "mode": "codex_app_server",
        "timeout_seconds": 5,
        "ttl_seconds": 120,
        "refresh_seconds": 60
      },
      "poll_interval_seconds": 2
    },
    "notion": {"enabled": false, "mode": "api", "token_env": "NOTION_API_TOKEN", "database_ids": [], "allow_all_shared_pages": false},
    "drive": {"enabled": false, "mode": "api", "refresh_token_env": "GOOGLE_REFRESH_TOKEN", "client_id_env": "GOOGLE_CLIENT_ID", "client_secret_env": "GOOGLE_CLIENT_SECRET", "folder_ids": [], "allow_all_files": false},
    "sheets": {"enabled": false, "mode": "api", "refresh_token_env": "GOOGLE_REFRESH_TOKEN", "client_id_env": "GOOGLE_CLIENT_ID", "client_secret_env": "GOOGLE_CLIENT_SECRET", "spreadsheets": []},
    "github": {"enabled": false, "mode": "api", "token_env": "GITHUB_TOKEN", "repositories": [], "deployment_workflows": ["deploy", "release", "production"]},
    "deployment": {"enabled": false, "mode": "api", "endpoint": "", "token_env": "DEPLOYMENT_API_TOKEN"},
    "sentry": {"enabled": false, "mode": "api", "token_env": "SENTRY_AUTH_TOKEN", "organization": "", "projects": []},
    "posthog": {"enabled": false, "mode": "api", "token_env": "POSTHOG_PERSONAL_API_KEY", "project_id": "", "checks": []},
    "shopify": {"enabled": false, "mode": "api", "token_env": "SHOPIFY_ACCESS_TOKEN", "shop": "", "required_scopes": ["read_products"]},
    "superhuman": {"enabled": false, "mode": "api", "refresh_token_env": "GOOGLE_REFRESH_TOKEN", "client_id_env": "GOOGLE_CLIENT_ID", "client_secret_env": "GOOGLE_CLIENT_SECRET", "query": "label:reminder newer_than:30d"},
    "stripe": {"enabled": false, "mode": "api", "token_env": "STRIPE_RESTRICTED_KEY"},
    "home_assistant": {"enabled": false, "mode": "api", "endpoint": "", "token_env": "HOME_ASSISTANT_TOKEN", "entities": []}
  }
}
