{
  "secrets": {
    "provider": "macos_keychain",
    "service": "com.founderos.runtime",
    "accounts": [
      "LINEAR_CLIENT_ID",
      "LINEAR_REFRESH_TOKEN",
      "SLACK_BOT_TOKEN",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "GOOGLE_REFRESH_TOKEN",
      "BUSY_API_TOKEN"
    ]
  },
  "runtime": {
    "environment": "production",
    "timezone": "Europe/Madrid",
    "connector_workers": 6
  },
  "operations": {
    "health_enabled": true,
    "heartbeat_seconds": 15
  },
  "closure": {
    "enabled": true,
    "default_owner": "self"
  },
  "display": {
    "host": "127.0.0.1:8080",
    "application_name": "founderos",
    "device_priority": 90,
    "api_semver": "25.0.0",
    "validate_on_start": true,
    "lease_seconds": 300,
    "text_rendering": "auto"
  },
  "automations": {
    "calendar_busy_indicator": {
      "enabled": false,
      "mode": "busybar_matter",
      "host": "",
      "api_token_env": "BUSY_API_TOKEN",
      "allow_insecure_http": false,
      "require_pairing": true,
      "include_all_day": false,
      "include_tentative": true,
      "off_delay_seconds": 15,
      "lease_min_ttl_seconds": 5,
      "lease_max_ttl_seconds": 28800
    }
  },
  "interaction": {
    "enabled": false
  },
  "llm": {
    "enabled": false
  },
  "connectors": {
    "demo": {
      "enabled": false
    },
    "linear": {
      "enabled": true,
      "mode": "api",
      "auth_scheme": "bearer",
      "oauth_refresh": true,
      "refresh_token_env": "LINEAR_REFRESH_TOKEN",
      "client_id_env": "LINEAR_CLIENT_ID",
      "scope": "portfolio",
      "team_keys": ["BUSY"],
      "portfolio_priority_ceiling": 2,
      "portfolio_due_horizon_days": 14,
      "rollup_projects": true,
      "critical": true,
      "poll_interval_seconds": 30
    },
    "calendar": {
      "enabled": true,
      "mode": "api",
      "refresh_token_env": "GOOGLE_REFRESH_TOKEN",
      "client_id_env": "GOOGLE_CLIENT_ID",
      "client_secret_env": "GOOGLE_CLIENT_SECRET",
      "calendar_id": "primary",
      "timezone": "Europe/Madrid",
      "critical": true,
      "poll_interval_seconds": 60
    },
    "slack": {
      "enabled": true,
      "mode": "api",
      "token_env": "SLACK_BOT_TOKEN",
      "channel_ids": ["C0123456789"],
      "channel_names": {"C0123456789": "launch"},
      "mention_markers": ["<@U012FOUNDER>"],
      "self_user_ids": ["U012FOUNDER"],
      "critical": true,
      "poll_interval_seconds": 60
    },
    "gmail": {
      "enabled": true,
      "mode": "api",
      "refresh_token_env": "GOOGLE_REFRESH_TOKEN",
      "client_id_env": "GOOGLE_CLIENT_ID",
      "client_secret_env": "GOOGLE_CLIENT_SECRET",
      "queries": [
        {"query": "is:unread newer_than:2d", "direction": "incoming"},
        {"query": "in:sent newer_than:30d {\"I will\" \"I'll\" \"I’ll\" \"we will\" \"je vais\" \"je vous envoie\" \"nous allons\" \"je reviens vers\"}", "direction": "outgoing"}
      ],
      "critical": true,
      "poll_interval_seconds": 60
    },
    "claude": {
      "enabled": false
    },
    "chatgpt_codex": {
      "enabled": false
    },
    "notion": {"enabled": false},
    "drive": {"enabled": false},
    "sheets": {"enabled": false},
    "github": {"enabled": false},
    "deployment": {"enabled": false},
    "sentry": {"enabled": false},
    "posthog": {"enabled": false},
    "shopify": {"enabled": false},
    "superhuman": {"enabled": false},
    "stripe": {"enabled": false},
    "home_assistant": {"enabled": false}
  }
}
